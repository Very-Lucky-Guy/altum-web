# Configure these in Vercel; never commit real keys.
SITE_URL=http://localhost:8793
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_LIVE_MODE=false
APLIIQ_APP_ID=
APLIIQ_SHARED_SECRET=
CRON_SECRET=
# Explicit launch gates. Test Stripe payments never create Apliiq orders.
SALES_ENABLED=false
FULFILLMENT_ENABLED=false
# Prices in US cents; shipping must be explicitly set (0 means free).
ORIGO_PRICE_CENTS=
US_SHIPPING_CENTS=
# Required public customer-service and approved policy copy before checkout.
SUPPORT_EMAIL=
SHIPPING_POLICY_EN=
SHIPPING_POLICY_ES=
RETURNS_POLICY_EN=
RETURNS_POLICY_ES=
# Set only after deciding the business's tax collection obligations.
TAX_REVIEW_COMPLETE=false
